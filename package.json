{
  "name": "fourjs-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "tools/docs"
  ],
  "scripts": {
    "bench": "bun benchmarks/run-all.mjs",
    "blending:build": "bunx vite build examples/blending",
    "build": "bun run --filter './packages/*' --sequential build",
    "character:build": "bunx vite build examples/character-controller",
    "check-compat": "bun tools/generate-compatibility.mjs --check",
    "check-docs": "bun tools/check-docs.mjs",
    "check-spec": "bun tools/check-spec.mjs",
    "coverage": "bun tools/run-in-packages.mjs --concurrency=4 vitest run --coverage --config ../../vitest.coverage.config.ts",
    "docs": "bun run --filter @fourjs-tools/docs build",
    "example:build": "bunx vite build examples/first-2d-scene",
    "examples:build": "bun run example:build && bun run first-3d-scene:build && bun run playground:build && bun run mechanism:build && bun run blending:build && bun run particles-demo:build && bun run ui-demo:build && bun run flagship:build && bun run twin:build && bun run character:build && bun run gltf-model:build",
    "first-3d-scene:build": "bunx vite build examples/first-3d-scene",
    "flagship:build": "bunx vite build examples/flagship/one-scene-everything-moves",
    "format": "bunx prettier --write .",
    "graph": "bun tools/create-dependency-graph/create-dependency-graph.ts --root=.",
    "graph:check": "bun tools/query-dependency-graph/query-dependency-graph.mjs --check-browser-safety",
    "graph:duplicates": "bun tools/create-dependency-graph/check-duplicates.mjs --no-regen",
    "graph:query": "bun tools/query-dependency-graph/query-dependency-graph.mjs --emit",
    "graph:test": "node --test tools/query-dependency-graph/query-dependency-graph.test.mjs",
    "lint": "bunx oxlint --type-aware",
    "mechanism:build": "bunx vite build examples/mechanism",
    "particles-demo:build": "bunx vite build examples/particles-demo",
    "playground:build": "bunx vite build examples/physics-playground",
    "publish-names": "bun tools/apply-publish-names.mjs",
    "publish-names:test": "node --test tools/apply-publish-names.test.mjs",
    "release:publish": ": \"${FOUR_PUBLISH_STAGING:?set it to a staging directory outside the checkout}\" && bun tools/apply-publish-names.mjs --out=\"$FOUR_PUBLISH_STAGING\" && for dir in \"$FOUR_PUBLISH_STAGING\"/*/; do npm publish \"$dir\" --access public || exit 1; done",
    "release:version": "bunx changeset version",
    "size": "bunx size-limit",
    "test": "bun tools/run-in-packages.mjs --concurrency=4 --script test",
    "test:browser": "bunx playwright test",
    "test:suites": "bunx vitest run --config vitest.suites.config.ts --passWithNoTests",
    "twin:build": "bunx vite build examples/flagship/motor-digital-twin",
    "typecheck:examples": "node node_modules/typescript/bin/tsc --noEmit -p examples",
    "typecheck:tests": "node node_modules/typescript/bin/tsc --noEmit -p tests",
    "typecheck:benchmarks": "node node_modules/typescript/bin/tsc -p benchmarks/tsconfig.typecheck.json",
    "ui-demo:build": "bunx vite build examples/ui-demo",
    "gltf-model:build": "bunx vite build examples/gltf-model",
    "typecheck:config": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:ts6": "node tools/docs/node_modules/typescript/bin/tsc --noEmit -p tests && node tools/docs/node_modules/typescript/bin/tsc --noEmit -p examples && node tools/docs/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@fourjs/animation": "workspace:*",
    "@fourjs/assets": "workspace:*",
    "@fourjs/core": "workspace:*",
    "@fourjs/diagnostics": "workspace:*",
    "@fourjs/geometry": "workspace:*",
    "@fourjs/input": "workspace:*",
    "@fourjs/materials": "workspace:*",
    "@fourjs/math": "workspace:*",
    "@fourjs/motion": "workspace:*",
    "@fourjs/particles": "workspace:*",
    "@fourjs/physics": "workspace:*",
    "@fourjs/physics-box2d": "workspace:*",
    "@fourjs/physics-rapier": "workspace:*",
    "@fourjs/physics-soft": "workspace:*",
    "@fourjs/render": "workspace:*",
    "@fourjs/render-canvas": "workspace:*",
    "@fourjs/render-svg": "workspace:*",
    "@fourjs/render-webgl": "workspace:*",
    "@fourjs/render-webgpu": "workspace:*",
    "@fourjs/scene": "workspace:*",
    "@fourjs/serialization": "workspace:*",
    "@fourjs/text": "workspace:*",
    "@fourjs/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "fourJS": "workspace:*",
    "js-yaml": "^4.3.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
